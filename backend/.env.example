# backend/.env.example
# Copy this file to .env and adjust values as needed.
# Never commit .env to Git — it is in .gitignore.

# ─── AI Mode ──────────────────────────────────────────────────────────────────
# true  → use mock implementations (no AI modules needed)
# false → use real AI modules in /ai/ (teammates must implement them first)
AI_MOCK_MODE=true

# ─── File Limits ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
